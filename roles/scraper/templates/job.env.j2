# {{ ansible_managed }}
SCRAPER_IMAGE={{ scraper_image }}
SCRAPER_ARGS=--list data/apps/{{ item.list }} --store {{ item.store }} {{ item.args | default([]) | map('quote') | join(' ') }}
{% if scraper_checks is defined and scraper_checks.results is defined %}
HC_PING_URL={{ scraper_checks.results[scraper_job_index].json.ping_url | default('') }}
{% else %}
HC_PING_URL={{ item.ping_url | default('') }}
{% endif %}
